services:
  redis:
    image: redis:7-alpine
    container_name: redis
    ports:
      - "6379:6379"

  api:
    build:
      context: ./api
    container_name: api
    env_file:
      - ./api/.env.example
    environment:
      - REDIS_URL=redis://redis:6379/0
    volumes:
      - ./api:/app
      - ./lstm-repo:/app/lstm-repo:ro
    depends_on:
      - redis
    ports:
      - "8000:8000"
    command: uvicorn main:app --host 0.0.0.0 --port 8000 --reload

  frontend:
    build:
      context: ./frontend
    container_name: frontend
    env_file:
      - ./frontend/.env.example
    environment:
      - NEXT_PUBLIC_API_URL=/api
    depends_on:
      - api
    expose:
      - "80"

  nginx:
    image: nginx:alpine
    container_name: edge
    depends_on:
      - frontend
      - api
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - frontend_build:/usr/share/nginx/html:ro

volumes:
  frontend_build:
